# Cloudflare Pages headers.
# https://developers.cloudflare.com/pages/configuration/headers/

# Assets are always referenced by an exact filename and change rarely, so a
# long immutable cache is safe. Bump the filename if one ever needs to change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML (and the form script it loads) must stay fresh so a redeploy is visible immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/forms.js
  Cache-Control: public, max-age=0, must-revalidate

# Baseline security headers.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
